# Webapp configuration. Copy to .env and adjust.

# Where the SQLite database file lives. In Docker this points at a mounted volume.
DATABASE_PATH=./data/app.db

# Better Auth — generate a long random string for production.
# e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-0123456789
# Public origin the browser uses. On a phone over LAN this is the host's IP.
BETTER_AUTH_URL=http://localhost:3000

# Voice backend (the Python WebSocket brain). The webapp calls its small HTTP
# API for memory wipe and vault reads; the phone reaches the WS directly.
VOICEBOT_API_URL=http://voicebot:8766
VOICEBOT_WS_URL=ws://localhost:8765
