# Health-companion device — App Lab config. Copy to .env (do NOT commit secrets).

# --- Voice Agent Service (the brain) ---------------------------------------
# Session voice URL printed by `companion open` on the memory-owner machine.
VA_VOICE_WS_URL=wss://voice-agent-service.example.eu/v1/sessions/<id>/voice
VA_OUTPUT_RATE=24000
# Cloudflare Access service token (same values as the companion repo .env):
VA_CF_ACCESS_CLIENT_ID=
VA_CF_ACCESS_CLIENT_SECRET=
# Idle seconds before returning to wake-word standby.
PIPELINE_SLEEP_TIMEOUT=45

# --- Wake word (sherpa-onnx keyword spotting, offline, no training) --------
WAKE_WORD_PHRASE=hey kay
WAKE_WORD_DEBOUNCE_SEC=3.0
# Mic device (ALSA). Leave to auto-detect, or pin it:
# WAKE_WORD_MIC=plughw:0,0
# Sensitivity: lower threshold / higher score = easier to trigger (more false hits).
# KWS_THRESHOLD=0.25
# KWS_SCORE=1.5
# Extra phrasings, added as additional keywords:
# WAKE_WORD_ALIASES=hey kaye

# --- Beeps -----------------------------------------------------------------
# BEEP=0   # disable the record start/stop tones
