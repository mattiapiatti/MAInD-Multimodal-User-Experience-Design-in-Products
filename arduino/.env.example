# Kai device (Arduino UNO Q) — App Lab config.
# Copy to arduino/.env on the board (or set the vars in the App Lab config UI).
# NEVER commit .env: it holds this board's secrets.
#
# Every variable the device reads is listed here. Commented lines show the
# default used when the variable is unset — uncomment only what you change.

# ============================================================================
# 1. Voice Agent Service — REQUIRED
# ============================================================================

# Live session voice URL, printed by `companion open` on the memory-owner
# machine. Ephemeral: when the device stops connecting, re-run `companion open`
# and paste the new URL here.
VA_VOICE_WS_URL=wss://voice-agent-service.mattiapiatti.eu/v1/sessions/<session-id>/voice

# Cloudflare Access service token (same values as the companion .env in the repo
# root). Without them the edge answers HTTP 403. Get them from the server owner.
VA_CF_ACCESS_CLIENT_ID=<client-id>.access
VA_CF_ACCESS_CLIENT_SECRET=<client-secret>

# This board's own device token, issued by the server owner with
#   voice-agent-devices issue "<board name>"
# It binds to THIS board on first use: copied to another board it is refused.
# One token per board — never reuse another board's token.
VA_DEVICE_TOKEN=vadev_<id>_<secret>

# Older aliases, still accepted (prefer the names above):
# VOICE_WS_URL=
# VA_ACCESS_CLIENT_ID=
# VA_ACCESS_CLIENT_SECRET=
# Extra raw header on the voice connection: CF_HEADER_<Header-Name>=<value>

# ============================================================================
# 2. Conversation
# ============================================================================

# Reply audio rate in Hz (the server announces its own in `ready`).
# VA_OUTPUT_RATE=24000
# Seconds of nobody speaking before going back to wake-word standby.
# PIPELINE_SLEEP_TIMEOUT=45
# Trailing silence (ms) that ends your utterance. Lower = snappier, but may cut you off.
# SILENCE_MS=1500
# Record start/stop beeps (0 = off).
# BEEP=1

# ============================================================================
# 3. Wake word
# ============================================================================

# sherpa = offline sherpa-onnx keyword spotting (no training needed)
# ei     = custom Edge Impulse model (arduino/models/hey-kay.eim, not in git)
# WAKE_ENGINE=sherpa

# --- sherpa-onnx ---
# WAKE_WORD_PHRASE=hey kay
# Extra phrasings, comma-separated:
# WAKE_WORD_ALIASES=hey kaye,hey kai
# Lower threshold / higher score = triggers more easily (and more false hits).
# KWS_THRESHOLD=0.25
# KWS_SCORE=1.5
# Model folder. Default: arduino/models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
# (bundled, not in git), then the cache, then a one-off download.
# SHERPA_MODEL_DIR=
# SHERPA_CACHE=~/.cache/sherpa-onnx

# --- Edge Impulse (WAKE_ENGINE=ei) ---
# WAKE_WORD_LABEL=hey_kay
# EI_THRESHOLD=0.6
# EI_KEYWORD_SPOTTING_MODEL=   (default: arduino/models/hey-kay.eim)

# --- timing ---
# Ignore repeated detections within this window (s).
# WAKE_WORD_DEBOUNCE_SEC=3.0
# Wait after the wake word before opening the conversation mic (s).
# WAKE_WORD_POST_SILENCE_SEC=0.0
# Ignore detections right after the listener (re)starts — avoids the reply's
# echo re-triggering a session (s).
# WAKE_WORD_WARMUP_SEC=0.8

# ============================================================================
# 4. Microphone & capture
# ============================================================================

# ALSA mic device. Empty = auto-detect the USB mic (capture-only card).
# Find yours with `arecord -l`, e.g. plughw:CARD=Device,DEV=0 or plughw:1,0
# WAKE_WORD_MIC=
# Conversation mic (defaults to WAKE_WORD_MIC, then auto-detect).
# AUDIO_CAPTURE_DEVICE=
# Native capture rate of the mic (Hz); audio is resampled to 16 kHz.
# WAKE_WORD_CAP_RATE=48000
# AUDIO_CAP_RATE=48000
# Software gain on the captured audio.
# AUDIO_BOOST=1.0
# ALSA mic gain during a conversation / restored for the wake word (e.g. 50% / 100%).
# Empty = leave the mixer alone. Too high → clipped speech → bad transcripts.
# AUDIO_CAPTURE_GAIN=
# AUDIO_WAKE_GAIN=
# ALSA capture control name for the gains above (`amixer -c <card> scontrols`).
# AUDIO_MIC_CONTROL=Mic
# Discard the first N 40 ms chunks (arecord cold start) / keep N chunks of pre-roll.
# CAPTURE_WARMUP_CHUNKS=2
# CAPTURE_PREROLL_CHUNKS=4
# Per-utterance normalization: target peak (0..1) and max amplification.
# AUDIO_NORMALIZE_PEAK=0.85
# AUDIO_NORMALIZE_MAX_GAIN=6.0

# ============================================================================
# 5. Voice activity detection (when you stopped talking)
# ============================================================================

# Absolute RMS floor, and margin above the measured room noise that counts as speech.
# VAD_THRESHOLD=500
# VAD_DELTA=700
# 40 ms chunks used to measure the room noise at the start of each turn.
# VAD_CALIB_CHUNKS=6
# Shortest utterance accepted / hard cap on one utterance (ms).
# VAD_MIN_SPEECH_MS=300
# VAD_MAX_SPEECH_MS=15000
# 1 = log rms/noise/threshold per chunk (for tuning).
# VAD_DEBUG=0

# ============================================================================
# 6. Speaker
# ============================================================================

# Seconds to wait for the reply audio to finish playing.
# AUDIO_DRAIN_TIMEOUT=20
# ALSA playback buffer / period (µs). Raise if the reply stutters.
# AUDIO_PLAYBACK_BUFFER_US=200000
# AUDIO_PLAYBACK_PERIOD_US=40000

# ============================================================================
# 7. Button
# ============================================================================

# How often the Linux side polls the MCU button (s), only while idle.
# BUTTON_POLL_SEC=0.09
