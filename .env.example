# Voice assistant — configuration template. Copy to .env and adjust if needed.
# All defaults are production-safe for a local OrbStack + host-Ollama setup.

# --- language model (Ollama on the host) ---
# OrbStack maps host.docker.internal to the Mac automatically.
OLLAMA_URL=http://host.docker.internal:11434
VOICEBOT_LOCAL_MODEL=gemma3n:e4b
# VOICEBOT_TEMPERATURE=0.4
# VOICEBOT_MAX_TOKENS=512

# --- speech-to-text (faster-whisper) ---
# Must match the model baked into the image (docker-compose build arg WHISPER_MODEL).
VOICEBOT_WHISPER_MODEL=base.en
# VOICEBOT_LANGUAGE=en

# --- text-to-speech (Kokoro, local ONNX) ---
# Model + voices are baked into the image; override the paths only for local runs.
# VOICEBOT_KOKORO_MODEL=/app/models/kokoro-v1.0.onnx
# VOICEBOT_KOKORO_VOICES=/app/models/voices-v1.0.bin
# Voice id (see hexgrad/Kokoro-82M VOICES.md). af_heart is a warm, expressive
# US-English voice; try af_bella, am_michael, bf_emma, etc.
VOICEBOT_KOKORO_VOICE=af_heart
# VOICEBOT_KOKORO_SPEED=1.0   # speaking-rate multiplier (1.0 = natural)
# VOICEBOT_KOKORO_LANG=en-us

# --- websocket server ---
# VOICEBOT_WS_HOST=0.0.0.0
# VOICEBOT_WS_PORT=8765
# VOICEBOT_INPUT_SAMPLE_RATE=16000

# --- logging ---
VOICEBOT_LOG_JSON=true
# VOICEBOT_LOG_LEVEL=INFO

# --- adaptive Hebbian memory (Obsidian-style note vault) ---
# A folder of linked markdown notes; edge weights strengthen co-activated memories
# and decay unused ones. Fully local — the extractor reuses the Ollama model above.
# VOICEBOT_MEMORY_ENABLED=true
# VOICEBOT_MEMORY_VAULT_PATH=/app/memory/vault
# VOICEBOT_MEMORY_EXTRACTOR_MODEL=        # empty → reuse VOICEBOT_LOCAL_MODEL
# VOICEBOT_MEMORY_TOP_K=5                 # recalled memories per turn
# VOICEBOT_MEMORY_SPREAD_HOPS=2           # spreading-activation radius
# VOICEBOT_MEMORY_SPREAD_DECAY=0.6        # damping per hop
# VOICEBOT_MEMORY_ETA=0.3                 # Hebbian learning rate
# VOICEBOT_MEMORY_DECAY_TAU_DAYS=30       # forgetting time constant (days)
# VOICEBOT_MEMORY_EDGE_FLOOR=0.05         # prune links weaker than this
# VOICEBOT_MEMORY_LINK_DISPLAY_FLOOR=0.15 # min weight shown as an Obsidian [[wikilink]]
