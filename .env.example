# Health Companion client (v2) — configuration (copy to .env, override as needed).
# This project owns the persona and the memory; it runs no model. All speech,
# language, and memory compute happen in the external Voice Agent Service.
#
# v2 connects to the *deployed* service over HTTPS/WSS, behind Cloudflare Access.
# (v1 pointed at a local engine on 127.0.0.1:8080 with no auth — still supported,
#  see "Local engine" below.)

# --- the deployed Voice Agent Service ---
VA_BASE_URL=https://voice-agent-service.mattiapiatti.eu

# --- Cloudflare Access service token (machine-to-machine) ---
# Required by the deployed server: sent on every REST, SSE, and WebSocket call.
# The secret is shown once at token creation and lives in the deployment owner's
# secret store — never commit it. If lost, recreate the Access service token.
VA_CF_ACCESS_CLIENT_ID=<client-id>.access
VA_CF_ACCESS_CLIENT_SECRET=<client-secret>

# --- Local engine instead of the deployed server (optional) ---
# Point at a co-located service and leave the CF_ACCESS vars empty:
# VA_BASE_URL=http://127.0.0.1:8080

# --- what this project owns (defaults are fine) ---
# COMPANION_PERSONA_PATH=./persona/system_prompt.txt
# COMPANION_VAULT_DIR=./memory/vault
# COMPANION_KNOWLEDGE_DIR=./memory/knowledge

# Note types this companion always wants surfaced as context every turn. Passed to
# the generic service so it knows this domain's "always-on" memory.
COMPANION_PROFILE_TYPES=therapy,preference

# --- misc ---
COMPANION_REQUEST_TIMEOUT=30
COMPANION_LOG_LEVEL=INFO
